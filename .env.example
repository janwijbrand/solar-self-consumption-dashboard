# SolarEdge API
SOLAREDGE_API_KEY=your_api_key_here
SOLAREDGE_SITE_ID=your_site_id_here

# Site location (used by collect_weather.py and backfill_weather.py)
SITE_LAT=52.0
SITE_LON=4.5

# Weather / forecast
WEATHER_DATA_START=2019-01-01   # date your solar panels were installed
GHI_MAX=900.0                    # observed clear-sky irradiance ceiling W/m² (fallback only)
PANEL_TILT=35                    # panel tilt angle in degrees (0=horizontal, 90=vertical)
PANEL_AZIMUTH=180                # panel azimuth in degrees (180=south, 90=east, 270=west)
PANEL_TEMP_COEF=0.0040           # temperature coefficient as a positive fraction per °C above 25°C
                                 # standard silicon: 0.0040, SunPower Max3 390W: 0.0029

# Battery simulation defaults (dashboard UI overrides via dropdown)
BATTERY_KWH=8.0
BATTERY_START=2025-01-01         # date to start SOC simulation from

# Dashboard
DASHBOARD_HOST=energy.your-tailnet.ts.net  # used by make deploy (set in shell, not .env)

# NED (Nationaal Energie Dashboard) carbon intensity
NED_API_KEY=your_ned_api_key_here  # register at https://ned.nl

# Database
DB_HOST=dsmrdb                   # Docker network hostname
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
